# Never put secrets in H5 / mini-program settings.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DB_DRIVER=sqlite
SQLITE_PATH=./var/nanchong.sqlite
# Production: DB_DRIVER=postgres, install integrations dependencies first.
DATABASE_URL=
DATABASE_SSL_CA_FILE=
ADMIN_TOKEN=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PUBLIC_BASE_URL=http://127.0.0.1:3000
H5_MAP_KEY=
TRANSIT_APP_ID=
TRANSIT_APP_PATH=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
TRANSIT_CONFIG=./deploy/transit.example.json
IVY_BUS_HOST=
IVY_APP_KEY=
IVY_APP_SECRET=
IVY_ENCODING_AES_KEY=
IVY_HTTP_ENCRYPT=true
IVY_MQTT_BROKER=
IVY_MQTT_USERNAME=
IVY_MQTT_PASSWORD=
IVY_MQTT_CA_FILE=
IVY_MQTT_GROUP=
IVY_MQTT_CLIENT_ID=
# This format is an explicit integration contract; confirm it with IVY support.
IVY_MQTT_ENVELOPE=signed-json-v1
IVY_PROTOCOL_CONFIRMED=false
IVY_MQTT_LOCATION_TOPIC=vehicle_location
IVY_MQTT_STOP_TOPIC=vehicle_stop
AMAP_SERVER_KEY=
WORKER_INSTANCE_ID=
# Set after the supplier confirms the device reporting period.
POSITION_FRESH_MS=60000
POSITION_STALE_MS=300000
MAX_FUTURE_MS=30000
SIGNATURE_MAX_AGE_MS=300000

# Trust forwarded client IP only from explicitly configured reverse-proxy peers
TRUSTED_PROXY_IPS=
RATE_PER_MINUTE=1200

# AI operations assistant (server-side only; leave blank to disable)
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=

# Local/test OTP only. Ignored in production; never use as a production bypass.
TEST_LOGIN_CODE=246810
INITIAL_ADMIN_PHONE_HASH=

# Formal SMS gateway. The service expects an internal HTTPS JSON gateway returning success=true / code=0 / code=OK / status=sent.
SMS_PROVIDER=
SMS_SEND_URL=
SMS_PROVIDER_TOKEN=
SMS_TEMPLATE_ID=
SMS_SIGN_NAME=

# Official WeChat preview gate (CI/runtime acceptance only; do not commit the private key).
WECHAT_MINIPROGRAM_APP_ID=
WECHAT_UPLOAD_PRIVATE_KEY_FILE=
WECHAT_CI_ROBOT=1
