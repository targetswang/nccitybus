.safe-bottom{padding-bottom:env(safe-area-inset-bottom)}.nav{position:fixed;left:0;right:0;bottom:0;z-index:20;background:#fffefa;border-top:1rpx solid #e5e9df;display:grid;grid-template-columns:repeat(4,1fr);min-height:116rpx}.item{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6rpx;color:#8b9787;font-size:22rpx}.icon{font-size:38rpx;line-height:1}.active{color:#235b40;font-weight:600}