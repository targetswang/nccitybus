.card{overflow:hidden;background:#fff;border:1rpx solid #e0e7da;border-radius:26rpx;margin-bottom:20rpx}.image{width:100%;height:340rpx;background:linear-gradient(135deg,#dcebd9,#f3ead3);display:flex;align-items:center;justify-content:center;color:#5f806c}.body{padding:24rpx}.top{display:flex;justify-content:space-between;align-items:center}.tag{font-size:20rpx;color:#8e6429;background:#f7ecd7;padding:8rpx 12rpx;border-radius:999rpx}.score{font-size:26rpx;color:#9b6c2d;font-weight:600}.name{font-size:32rpx;font-weight:700;color:#214b3d;margin-top:14rpx}.meta{font-size:22rpx;color:#82907e;margin-top:8rpx}.reason{font-size:24rpx;line-height:1.6;color:#66796b;margin-top:10rpx}