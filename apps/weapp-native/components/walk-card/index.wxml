<view class="card" bindtap="open">
  <image wx:if="{{cover&&!failed}}" class="cover" src="{{cover}}" mode="aspectFill" binderror="imageError"/><view wx:else class="cover">
    <view class="cover-title">CITY WALK</view>
    <view class="cover-sub">{{walk.duration}} · {{walk.bestTime}}</view>
  </view>
  <view class="body">
    <view class="name">{{walk.title}}</view>
    <view class="desc">{{walk.subtitle}}</view>
    <view class="tags"><text wx:for="{{walk.tags}}" wx:key="*this">{{item}}</text></view>
  </view>
</view>