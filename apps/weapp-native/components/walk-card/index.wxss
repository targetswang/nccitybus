.card{overflow:hidden;background:#fff;border:1rpx solid #dfe7da;border-radius:28rpx;margin-bottom:20rpx}.cover{height:230rpx;background:linear-gradient(135deg,#174637,#709b78);padding:28rpx;color:#fff}.cover-title{font-size:22rpx;letter-spacing:4rpx;color:#ead7aa}.cover-sub{font-size:24rpx;margin-top:12rpx}.body{padding:24rpx}.name{font-size:32rpx;font-weight:700;color:#214b3d}.desc{font-size:24rpx;line-height:1.6;color:#778779;margin-top:10rpx}.tags{display:flex;gap:10rpx;flex-wrap:wrap;margin-top:16rpx}.tags text{font-size:20rpx;color:#946b32;background:#f7ecd7;padding:7rpx 12rpx;border-radius:10rpx}
image.cover{display:block;width:100%;padding:0;box-sizing:border-box}
