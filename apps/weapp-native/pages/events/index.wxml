<view class="safe-page"><top-header title="城市活动" subtitle="活动专题 · 我的报名" showBack="{{true}}"/><view class="page-content"><view wx:if="{{!session}}" class="panel"><view>浏览无需登录，报名需要账户。</view><button class="primary-btn" bindtap="login">手机号登录</button></view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{note}}" class="hint">{{note}}</view><view wx:for="{{events}}" wx:key="id" class="panel"><image wx:if="{{item.cover}}" class="cover" src="{{item.cover}}" mode="aspectFill"/><view class="title">{{item.title}}</view><view class="copy">{{item.description}}</view><view class="muted">{{item.availabilityReason}}</view><view class="muted">{{item.organizer}} · {{item.address}}</view><view class="copy">参与规则：{{item.rules||item.terms}}</view><view wx:if="{{item.availability==='cancelled'}}" class="error">活动已取消：{{item.cancellationReason}}</view><button wx:if="{{item.registration==='free'}}" class="primary-btn" data-id="{{item.id}}" bindtap="register" disabled="{{busy||!session||item.availability!=='active'}}">免费活动报名</button></view><view wx:if="{{profile&&profile.registrations.length}}" class="panel"><view class="title">我的报名</view><view wx:for="{{profile.registrations}}" wx:key="id" class="record">{{item.title}} · {{item.status}}<button wx:if="{{item.status==='registered'}}" data-id="{{item.id}}" bindtap="cancel" disabled="{{busy}}">取消报名</button></view></view><view wx:if="{{!events.length&&!loading}}" class="empty">暂无已发布城市活动。</view></view><view class="page-content"><view wx:if="{{error&&lastLoaded}}" class="hint">内容刷新失败，当前仍显示此前读取的版本。</view><button class="secondary-btn" bindtap="refreshPage">刷新内容</button></view><bottom-nav active="me"/></view>
