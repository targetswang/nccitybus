.intro-title{font-family:serif;font-size:54rpx;line-height:1.38;color:#214a3d}.intro-sub{font-size:24rpx;line-height:1.7;color:#88977f;margin:16rpx 0 24rpx}.switch{display:grid;grid-template-columns:1fr 1fr;gap:6rpx;background:#eef3e9;padding:7rpx;border-radius:20rpx;margin-bottom:24rpx}.switch view{height:78rpx;display:flex;align-items:center;justify-content:center}.switch .active{background:#fff;border-radius:16rpx;color:#245b42;font-weight:600}.filters{white-space:nowrap;margin-bottom:20rpx}.filters view{display:inline-flex;padding:14rpx 24rpx;background:#f1f4eb;color:#7c8b79;border-radius:999rpx;margin-right:12rpx}.filters .active{background:#255f49;color:#fff}.station-picker{padding:18rpx 20rpx;border:1rpx solid #dfe6da;border-radius:16rpx;margin-bottom:20rpx;color:#647765}.error{background:#fff1ec;color:#995c4a;padding:16rpx;border-radius:14rpx;margin-bottom:18rpx}
