<view class="safe-page"><top-header title="我的收藏" subtitle="保存的沿线地点" showBack="{{true}}"/><view class="page-content"><view wx:if="{{error}}" class="empty">{{error}}</view><view wx:if="{{missing}}" class="hint">{{missing}}项收藏内容已不可用，原收藏标识仍被保留。</view><poi-card wx:for="{{pois}}" wx:key="id" poi="{{item}}"/><view wx:if="{{!pois.length&&!error}}" class="empty">还没有可显示的收藏。</view></view><view class="page-content"><view wx:if="{{error&&lastLoaded}}" class="hint">内容刷新失败，当前仍显示此前读取的版本。</view><button class="secondary-btn" bindtap="refreshPage">刷新内容</button></view><bottom-nav active="me"/></view>
