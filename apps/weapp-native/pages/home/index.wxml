<view class="safe-page"><top-header title="嘉陵江城市漫游" subtitle="查车 · 找站 · 漫游 · 刷码上车"/><view wx:if="{{error}}" class="page-content"><view class="panel error">{{error}}<button class="secondary-btn" bindtap="refresh">重新加载</button></view></view><block wx:if="{{catalog}}"><view class="hero"><view class="tag gold">城市漫游环线</view><view class="hero-title">{{home.heroTitle}}</view><view class="hero-sub">{{home.heroSubtitle}}</view><view class="river">NANCHONG CITY LOOP</view></view><view class="quick"><view class="quick-card" bindtap="transit"><view class="qicon">▣</view><view><view class="qtitle">乘车码</view><view class="qsub">刷码上车</view></view></view><view class="quick-card" bindtap="live"><view class="qicon ochre">▤</view><view><view class="qtitle">实时查车</view><view class="qsub">车辆 · 站点</view></view></view></view><view class="notice" bindtap="guide">{{catalog.notice}}</view><view class="page-content"><view wx:for="{{home.banners}}" wx:key="id" wx:if="{{item.placement==='home'}}" class="ops-banner" data-banner="{{item}}" bindtap="banner"><image wx:if="{{item.cover}}" src="{{item.cover}}" mode="aspectFill"/><view><view class="banner-title">{{item.title}}</view><view class="muted">{{item.subtitle}}</view></view></view><view class="section"><view class="section-title"><view class="title">一条线，慢游南充</view><view class="more" bindtap="route">线路总览</view></view><view class="route-card" bindtap="route"><view class="number">01</view><view class="route-copy"><view class="route-en">CITY LOOP</view><view class="route-name">{{catalog.routeName}}</view><view class="route-path">{{home.routePath}}</view></view></view></view><view class="section"><view class="section-title"><view class="title">漫游精选</view><view class="more" bindtap="explore">查看更多</view></view><view class="switch"><view class="{{mode==='walks'?'active':''}}" data-mode="walks" bindtap="switchMode">路线玩法</view><view class="{{mode==='places'?'active':''}}" data-mode="places" bindtap="switchMode">沿线地点</view></view><view wx:if="{{mode==='walks'}}"><walk-card wx:for="{{walks}}" wx:key="id" walk="{{item}}"/></view><view wx:else><poi-card wx:for="{{pois}}" wx:key="id" poi="{{item}}"/></view></view><view wx:for="{{home.announcements}}" wx:key="id" class="panel"><view class="title">{{item.title}}</view><view>{{item.body||item.content}}</view></view><view class="muted version">内容版本：{{catalog.version}}</view></view></block><bottom-nav active="home"/></view>
