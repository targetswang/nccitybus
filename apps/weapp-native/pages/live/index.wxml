<view class="safe-page"><top-header title="漫游地图" subtitle="南充城市漫游环线"/><picker wx:if="{{routes.length>1}}" range="{{routes}}" range-key="name" value="{{routeIndex}}" bindchange="routeChange"><view class="panel">线路：{{routes[routeIndex].name}}</view></picker><view class="layers"><view wx:for="{{layers}}" wx:key="key" class="{{layer===item.key?'active':''}}" data-key="{{item.key}}" bindtap="switchLayer">{{item.label}}</view></view><map id="live-map" bindmarkertap="markerTap" bindregionchange="regionChange" class="map" latitude="{{mapLat}}" longitude="{{mapLng}}" scale="{{scale}}" markers="{{markers}}" polyline="{{polyline}}" show-location></map><view class="page-content"><button class="secondary-btn" bindtap="refresh">刷新</button><view class="status {{snapshot&&snapshot.integration.state==='connected'?'good':''}}">{{message}}</view><view wx:if="{{error}}" class="error">{{error}}<button class="secondary-btn" bindtap="refresh">重新加载</button></view><view wx:if="{{!markers.length}}" class="panel"><view class="muted">当前图层没有经过核验的可绘制坐标。不会用模拟位置补齐。</view></view><view class="section-title"><view class="title">当前图层内容</view><view class="more" bindtap="stationsPage">全部站点</view></view><view wx:for="{{items}}" wx:key="id" class="station-card" data-id="{{item.id}}" bindtap="openItem"><view class="dot">{{index+1}}</view><view><view class="sname">{{item.name}}</view><view class="muted">{{item.subtitle}}</view></view></view><view wx:if="{{!items.length}}" class="empty">暂无可展示数据。</view><view class="primary-btn" bindtap="transit">准备上车 · 打开微信乘车码</view></view><bottom-nav active="live"/></view>
