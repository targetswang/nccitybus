.layers{display:flex;gap:12rpx;overflow-x:auto;padding:18rpx 28rpx;background:#fffef8}.layers view{flex:none;padding:14rpx 24rpx;background:#eef3e9;color:#718270;border-radius:999rpx;font-size:22rpx}.layers .active{background:#255f49;color:#fff}.map{width:calc(100% - 56rpx);height:620rpx;margin:0 28rpx;border-radius:28rpx;overflow:hidden}.status{padding:18rpx;background:#f7efdd;color:#876b3d;border-radius:16rpx;margin-bottom:20rpx;font-size:23rpx}.status.good{background:#eaf3e8;color:#356951}.error{background:#fff1ec;color:#995c4a;padding:16rpx;border-radius:14rpx;margin-bottom:18rpx}.station-card{display:flex;gap:20rpx;align-items:center;background:#fff;border:1rpx solid #e4e8dc;border-radius:24rpx;padding:24rpx;margin-bottom:16rpx}.dot{width:46rpx;height:46rpx;border-radius:50%;background:#eff4eb;color:#39705e;display:flex;align-items:center;justify-content:center}.sname{font-size:28rpx;font-weight:700}
