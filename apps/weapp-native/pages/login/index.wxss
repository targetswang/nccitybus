.title{font-size:34rpx;font-weight:700}.field{height:88rpx;border:1rpx solid #dfe6da;border-radius:18rpx;padding:0 22rpx;margin-top:18rpx;background:#fff;box-sizing:border-box}.code-row{display:grid;grid-template-columns:1fr 220rpx;gap:14rpx;align-items:end}.code-btn{margin-top:18rpx}.hint{background:#edf5e9;color:#4f724e;padding:16rpx;border-radius:14rpx;margin-top:14rpx}.agree{display:flex;align-items:flex-start;gap:10rpx;font-size:22rpx;color:#718071;margin:22rpx 0}.error{color:#9e5b49;background:#fff1ec;padding:16rpx;border-radius:14rpx;margin:16rpx 0}.gap{margin-top:14rpx}
