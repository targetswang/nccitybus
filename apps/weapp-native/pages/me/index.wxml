<view class="safe-page"><top-header title="我的漫游" subtitle="收藏 · 会员 · 权益 · 服务"/>
<view class="profile"><view class="avatar">我</view><view><view class="pname">{{session?session.user.phoneMasked:'我的漫游'}}</view><view class="muted">{{session?'账户记录已接入统一后端':'先漫游，登录后同步账户'}}</view></view></view>
<view wx:if="{{!session}}" class="login-strip" bindtap="login">手机号登录 / 注册 <text>›</text></view><view wx:if="{{error}}" class="error">{{error}}</view>
<view class="stats"><view bindtap="favorites"><view class="num">{{profile?profile.favorites.length:anonymousCount}}</view><view>我的收藏</view></view><view bindtap="stations"><view class="num">{{stationCount}}</view><view>环线站点</view></view><view bindtap="guide"><view class="num">?</view><view>乘车指南</view></view></view>
<view class="page-content"><view class="menu" bindtap="member"><view>会员服务</view><view class="muted">免费基础会员与服务规则</view></view><view class="menu" bindtap="rights"><view>我的权益</view><view class="muted">已发布权益与领取记录</view></view><view class="menu" bindtap="events"><view>城市活动</view><view class="muted">活动详情与我的报名</view></view><view class="menu" bindtap="messages"><view>我的消息</view><view class="muted">平台站内服务通知</view></view><view class="menu" bindtap="support"><view>客服与反馈</view><view class="muted">问题反馈与隐私申请</view></view><view class="menu" bindtap="favorites"><view>我的收藏</view><view class="muted">保存的沿线地点</view></view><view class="menu" bindtap="privacy"><view>数据与隐私</view><view class="muted">身份、定位与数据说明</view></view><button wx:if="{{session}}" class="secondary-btn" bindtap="onShow">刷新账户记录</button><button wx:if="{{session}}" class="secondary-btn" bindtap="logout">退出登录</button></view><view class="page-content"><view wx:if="{{error&&lastLoaded}}" class="hint">内容刷新失败，当前仍显示此前读取的版本。</view><button class="secondary-btn" bindtap="refreshPage">刷新内容</button></view><bottom-nav active="me"/></view>
