.profile{display:flex;align-items:center;gap:20rpx;padding:38rpx;background:#edf1e6}.avatar{width:92rpx;height:92rpx;border-radius:50%;background:#dce7d3;color:#749366;display:flex;align-items:center;justify-content:center;font-size:34rpx}.pname{font-size:34rpx;font-weight:700}.login-strip{margin:18rpx 28rpx 0;background:#245b42;color:#fff;padding:22rpx 26rpx;border-radius:20rpx;display:flex;justify-content:space-between}.stats{display:grid;grid-template-columns:repeat(3,1fr);background:#fff;border-bottom:1rpx solid #e7ecd9;padding:24rpx 10rpx;text-align:center;font-size:22rpx;color:#919e7f}.num{font-size:42rpx;color:#557945;font-weight:700}.menu{padding:26rpx 8rpx;border-bottom:1rpx solid #edf0e7;font-size:30rpx}.menu .muted{font-size:22rpx;margin-top:8rpx}.error{margin:16rpx 28rpx;background:#fff1ec;color:#995c4a;padding:16rpx;border-radius:14rpx}
