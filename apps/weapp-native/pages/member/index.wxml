<view class="safe-page"><top-header title="会员服务" subtitle="免费基础会员" showBack="{{true}}"/><view class="page-content"><view wx:if="{{!session}}" class="panel"><view>登录后加入会员并同步账户。</view><button class="primary-btn" bindtap="login">手机号登录</button></view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{note}}" class="hint">{{note}}</view><view wx:for="{{plans}}" wx:key="id" class="panel"><view class="title">{{item.name}}</view><view class="copy">{{item.description}}</view><view class="muted">{{item.terms}}</view><view wx:if="{{item.membership}}">有效至：{{item.expiry}}<button data-id="{{item.membership.id}}" bindtap="leave">退出会员</button></view><button wx:else class="primary-btn" data-id="{{item.id}}" bindtap="join" disabled="{{!session}}">阅读规则并加入</button></view><view wx:if="{{!plans.length&&!loading}}" class="empty">暂无已发布会员方案，基础乘车与漫游不受影响。</view></view><bottom-nav active="me"/></view>
