<view class="safe-page"><top-header title="我的消息" subtitle="平台站内服务通知" showBack="{{true}}"/><view class="page-content"><view wx:if="{{!session}}" class="panel"><button class="primary-btn" bindtap="login">登录查看消息</button></view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:for="{{profile.messages}}" wx:key="id" class="panel"><view class="title">{{item.title}}</view><view class="copy">{{item.body}}</view><view class="muted">{{item.time}}</view><view wx:if="{{item.read}}" class="tag">已读</view><button wx:if="{{!item.read}}" class="secondary-btn" data-id="{{item.id}}" bindtap="read" disabled="{{busy}}">标记已读</button></view><view wx:if="{{session&&profile&&!profile.messages.length}}" class="empty">暂无站内消息。</view></view><view class="page-content"><view wx:if="{{error&&lastLoaded}}" class="hint">内容刷新失败，当前仍显示此前读取的版本。</view><button class="secondary-btn" bindtap="refreshPage">刷新内容</button></view><bottom-nav active="me"/></view>
