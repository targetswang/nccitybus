<view class="safe-page"><top-header title="我的消息" subtitle="平台站内服务通知" showBack="{{true}}"/><view class="page-content"><view wx:if="{{!session}}" class="panel"><button class="primary-btn" bindtap="login">登录查看消息</button></view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:for="{{profile.messages}}" wx:key="id" class="panel"><view class="title">{{item.title}}</view><view class="copy">{{item.body}}</view><button wx:if="{{!item.read}}" class="secondary-btn" data-id="{{item.id}}" bindtap="read">标记已读</button></view><view wx:if="{{session&&profile&&!profile.messages.length}}" class="empty">暂无站内消息。</view></view><bottom-nav active="me"/></view>
