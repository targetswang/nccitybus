<view class="safe-page"><top-header title="地点详情" subtitle="沿线地点" showBack="{{true}}"/><view class="page-content"><view wx:if="{{error}}" class="empty">{{error}}</view><block wx:if="{{poi}}"><image wx:if="{{poi.cover}}" class="cover" src="{{poi.cover}}" mode="aspectFill"/><view wx:else class="cover fallback">{{poi.category}}</view><view class="tag gold">{{poi.category}}</view><view class="name">{{poi.name}}</view><view class="muted">{{poi.subcategory}}</view><view class="panel"><view class="line"><text>地址</text><text>{{poi.address}}</text></view><view class="line"><text>介绍</text><text>{{poi.description}}</text></view><view class="line"><text>营业说明</text><text>{{poi.openingHours||'请向商家或场地确认'}}</text></view><view class="line"><text>消费建议</text><text>{{poi.priceAdvice||'以现场公示为准'}}</text></view></view><narration text="{{poi.narration||poi.description}}" audio-url="{{poi.audioUrl}}"/><button wx:if="{{poi.nodeId}}" class="secondary-btn" bindtap="station">查看关联站点</button><view class="actions"><view wx:if="{{canNavigate}}" class="primary-btn" bindtap="nav">地图导航</view><view wx:else class="hint">暂未确认精确位置，请按地址核实后出行。</view><view class="secondary-btn" bindtap="fav">{{liked?'已收藏':'收藏'}}</view></view></block></view><view class="page-content"><view wx:if="{{error&&lastLoaded}}" class="hint">内容刷新失败，当前仍显示此前读取的版本。</view><button class="secondary-btn" bindtap="refreshPage">刷新内容</button></view><bottom-nav active="explore"/></view>
