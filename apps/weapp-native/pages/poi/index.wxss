.cover{width:100%;height:360rpx;border-radius:28rpx;background:#e9f0e4;margin-bottom:20rpx}.name{font-family:serif;font-size:46rpx;color:#244f40;margin:14rpx 0}.line{display:flex;gap:20rpx;justify-content:space-between;padding:18rpx 0;border-top:1rpx solid #edf0e8;font-size:24rpx}.line text:first-child{color:#8c9783;flex:none}.line text:last-child{text-align:right}.actions{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.copy{font-size:25rpx;line-height:1.8}.name.small{font-size:30rpx}.fallback{display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#dcebd9,#f3ead3);color:#54745f}
