<view class="safe-page"><top-header title="我的权益" subtitle="会员权益与领取记录" showBack="{{true}}"/><view class="page-content"><view wx:if="{{!session}}" class="panel"><view>浏览权益说明无需登录，领取需要账户。</view><button class="primary-btn" bindtap="login">手机号登录</button></view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{note}}" class="hint">{{note}}</view><view wx:for="{{benefits}}" wx:key="id" class="panel"><view class="title">{{item.name||item.title}}</view><view class="copy">{{item.description}}</view><view class="muted">{{item.availabilityReason}}</view><view class="muted">履约方：{{item.provider}} · 状态：{{item.availability}}</view><view class="rules">{{item.rules||item.terms}}</view><button class="primary-btn" data-id="{{item.id}}" bindtap="claim" disabled="{{busy||!session||item.availability!=='active'}}">确认规则并领取</button></view><view wx:if="{{profile&&profile.grants.length}}" class="panel"><view class="title">已领取权益</view><view wx:for="{{profile.grants}}" wx:key="id" class="record"><view>{{item.title}} · {{item.status}}</view><view class="muted">有效至 {{item.expiry}}</view><button class="secondary-btn" data-id="{{item.id}}" bindtap="open" disabled="{{busy}}">查看使用说明</button></view></view><view wx:if="{{!benefits.length}}" class="empty">暂无可领取的已发布权益。</view></view><view class="page-content"><view wx:if="{{error&&lastLoaded}}" class="hint">内容刷新失败，当前仍显示此前读取的版本。</view><button class="secondary-btn" bindtap="refreshPage">刷新内容</button></view><bottom-nav active="me"/></view>
