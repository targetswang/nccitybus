<view class="safe-page"><top-header title="线路总览" subtitle="嘉陵江城市漫游环线" showBack="{{true}}"/><view class="page-content"><view class="intro">{{routeName}}</view><view class="muted desc">{{stations.length}}个文旅站点。无需预约，随到随上、随站下车。实际停靠顺序和线路轨迹以公交系统发布为准。</view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:for="{{stations}}" wx:key="id" class="row" data-id="{{item.id}}" bindtap="station"><view class="dot">{{index+1}}</view><view><view class="name">{{item.name}}</view><view class="muted">{{item.persona}}</view></view></view><view class="primary-btn" bindtap="live">进入实时查车</view></view><view class="page-content"><view wx:if="{{error&&lastLoaded}}" class="hint">内容刷新失败，当前仍显示此前读取的版本。</view><button class="secondary-btn" bindtap="refreshPage">刷新内容</button></view><bottom-nav active="home"/></view>
