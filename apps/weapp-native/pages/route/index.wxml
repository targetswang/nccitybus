<view class="safe-page"><top-header title="线路总览" subtitle="嘉陵江城市漫游环线" showBack="{{true}}"/><view class="page-content"><view class="intro">{{routeName}}</view><view class="muted desc">第5站后返回黄金江岸，形成闭环。无需预约，随到随上、随站下车。</view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:for="{{stations}}" wx:key="id" class="row" data-id="{{item.id}}" bindtap="station"><view class="dot">{{index+1}}</view><view><view class="name">{{item.name}}</view><view class="muted">{{item.persona}}</view></view></view><view class="primary-btn" bindtap="live">进入实时查车</view></view><bottom-nav active="home"/></view>
