.title{font-size:32rpx;font-weight:700}.field,.textarea{border:1rpx solid #dfe6da;border-radius:16rpx;padding:20rpx;margin-bottom:18rpx;background:#fff;box-sizing:border-box}.textarea{width:100%;min-height:220rpx}.record{padding:20rpx 0;border-top:1rpx solid #edf0e7;font-size:24rpx;line-height:1.7}.reply{margin-top:10rpx;background:#edf5e9;padding:14rpx;border-radius:12rpx}.hint{background:#edf5e9;color:#4f724e;padding:16rpx;border-radius:14rpx;margin:14rpx 0}.error{background:#fff1ec;color:#995c4a;padding:16rpx;border-radius:14rpx;margin:14rpx 0}
