<view class="safe-page"><top-header title="路线详情" subtitle="City Walk" showBack="{{true}}"/><view class="page-content"><view wx:if="{{error}}" class="empty">{{error}}</view><block wx:if="{{walk}}"><image wx:if="{{cover}}" class="cover" src="{{cover}}" mode="aspectFill"/><view class="walk-title">{{walk.title}}</view><view class="muted sub">{{walk.subtitle}}</view><view class="copy">{{walk.routeLine}}</view><view class="muted">{{walk.audience}}</view><view class="facts"><view>{{walk.duration}}<text>预计时长</text></view><view>{{walk.bestTime}}<text>推荐时段</text></view></view><view class="panel"><view class="panel-title">这条路线为什么值得走</view><view class="story">{{walk.story}}</view></view><view class="step" wx:for="{{walk.steps}}" wx:key="title"><image wx:if="{{pois[item.poiId].cover}}" class="cover" src="{{pois[item.poiId].cover}}" mode="aspectFill"/><view class="step-no">0{{index+1}}</view><view class="step-title">{{item.title}}</view><view class="step-meta">{{item.stay}} · {{item.walkHint}}</view><view class="story">{{item.intro}}</view><view class="tip">像当地人一点：{{item.localTip}}</view><narration text="{{item.narration||item.audio}}" audio-url="{{item.audioUrl}}"/><view class="actions"><view wx:if="{{pois[item.poiId].canNavigate}}" bindtap="nav" data-id="{{item.poiId}}">导航</view><view wx:else class="muted">暂未确认精确位置，请按地址核实后出行。</view><view bindtap="poi" data-id="{{item.poiId}}">地点详情</view></view></view><view class="panel"><view class="panel-title">出发前知道这些</view><view wx:for="{{walk.practical}}" wx:key="*this" class="story">· {{item}}</view></view></block></view><view class="page-content"><view wx:if="{{error&&lastLoaded}}" class="hint">内容刷新失败，当前仍显示此前读取的版本。</view><button class="secondary-btn" bindtap="refreshPage">刷新内容</button></view><bottom-nav active="explore"/></view>
