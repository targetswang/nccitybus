.walk-title{font-family:serif;font-size:52rpx;color:#214a3d}.sub{font-size:24rpx;line-height:1.6;margin:10rpx 0 20rpx}.facts{display:grid;grid-template-columns:1fr 1fr;gap:14rpx;margin-bottom:22rpx}.facts view{background:#edf4e9;border-radius:18rpx;padding:20rpx;text-align:center;color:#2f644f;font-weight:600}.facts text{display:block;color:#879486;font-size:20rpx;margin-top:6rpx}.panel-title{font-size:30rpx;font-weight:700}.story{font-size:25rpx;line-height:1.8;color:#66776a;margin:14rpx 0}.step{background:#fff;border:1rpx solid #dfe6db;border-radius:26rpx;padding:26rpx;margin-bottom:20rpx}.step-no{color:#a6793a;font-size:22rpx}.step-title{font-size:34rpx;color:#234c3e;font-weight:700;margin-top:8rpx}.step-meta{font-size:21rpx;color:#718172;margin-top:10rpx}.tip{background:#faf1df;color:#796d5a;border-radius:16rpx;padding:18rpx;font-size:22rpx;line-height:1.6}.actions{display:grid;grid-template-columns:repeat(3,1fr);gap:10rpx;margin-top:18rpx}.actions view{height:72rpx;background:#eff4eb;color:#315f4b;border-radius:16rpx;display:flex;align-items:center;justify-content:center}.narration{background:#f4f7ef;border-radius:16rpx;padding:18rpx;margin-top:16rpx;font-size:24rpx;line-height:1.75}.actions{grid-template-columns:1fr 1fr}
