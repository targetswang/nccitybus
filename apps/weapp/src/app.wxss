page {
  background: __BACKGROUND__;
  color: __TEXT__;
  font-size: __BODY_RPX__;
  font-family: -apple-system,BlinkMacSystemFont,'PingFang SC','Microsoft YaHei','Noto Sans CJK SC',sans-serif;
  line-height: 1.6
}
view,button,scroll-view {
  box-sizing: border-box
}
button {
  font: inherit;
  color: inherit;
  background: none;
  border: 0;
  margin: 0;
  padding: 0;
  line-height: 1.5;
  min-height: 88rpx
}
button::after {
  border: 0
}
.screen {
  min-height: 100vh;
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom))
}
.content {
  padding: 32rpx
}
.h1 {
  font-family: 'Songti SC',serif;
  font-size: __TITLE_RPX__;
  line-height: 1.4;
  font-weight: 700;
  margin-bottom: 16rpx
}
.h2 {
  font-size: __HEADING_RPX__;
  line-height: 1.5;
  font-weight: 700
}
.h3 {
  font-size: 34rpx;
  line-height: 1.5;
  font-weight: 700
}
.copy {
  font-size: __BODY_RPX__;
  line-height: 1.85;
  margin-top: 18rpx;
  white-space: normal
}
.copy.secondary {
  font-size: __SECONDARY_RPX__;
  color: __MUTED__
}
.accent {
  color: __ACCENT__
}
.page-intro {
  margin: 24rpx 0 36rpx
}
.tag {
  display: inline-flex;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  font-size: __CAPTION_RPX__;
  background: #eef3e8;
  margin-top: 12rpx
}
.tag.gold {
  background: #e2c77e;
  color: #24573f
}
.hero {
  position: relative;
  margin: 24rpx 32rpx 0;
  height: 420rpx;
  border-radius: 36rpx;
  background: #164637;
  overflow: hidden;
  color: #fff8e5;
  padding: 32rpx 36rpx
}
.hero-title {
  position: relative;
  z-index: 1;
  font-family: serif;
  font-size: __TITLE_RPX__;
  line-height: 1.4;
  margin-top: 20rpx;
  white-space: pre-line
}
.hero-sub {
  position: relative;
  z-index: 1;
  font-size: __CAPTION_RPX__;
  color: #d5dfc9;
  margin-top: 12rpx
}
.hero-bus {
  position: absolute;
  right: -14rpx;
  bottom: -30rpx;
  width: 420rpx;
  height: 200rpx
}
.quick-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin: 24rpx 32rpx
}
.quick {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 190rpx;
  padding: 24rpx 18rpx;
  border: 1rpx solid __BORDER__;
  border-radius: 28rpx;
  background: white;
  text-align: left
}
.quick image {
  width: 74rpx;
  height: 74rpx;
  background: #edf3e8;
  border-radius: 20rpx;
  padding: 12rpx;
  flex: none
}
.quick .strong {
  font-size: 34rpx;
  font-weight: 700;
  display: block;
  white-space: nowrap
}
.quick .small {
  font-size: __CAPTION_RPX__;
  color: __MUTED__;
  display: block;
  margin-top: 8rpx
}
.notice {
  font-size: __CAPTION_RPX__;
  color: __MUTED__;
  margin: 0 36rpx;
  line-height: 1.7
}
.section-title {
  font-size: __HEADING_RPX__;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 32rpx 0 24rpx
}
.section-title button {
  font-size: __SECONDARY_RPX__;
  font-weight: 400;
  color: __BRAND__;
  min-width: 100rpx
}
.route-card {
  border: 1rpx solid __BORDER__;
  background: white;
  border-radius: 32rpx;
  overflow: hidden
}
.route-cover {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 34rpx;
  background: #e7eddc;
  color: #53714e
}
.route-number {
  font-family: Georgia,serif;
  font-style: italic;
  font-size: 90rpx;
  color: #8da68c
}
.route-cover>view {
  flex: 1
}
.route-cover>view>text {
  font-size: __CAPTION_RPX__;
  letter-spacing: 4rpx
}
.route-cover>image {
  width: 80rpx;
  height: 80rpx
}
.card-body {
  padding: 28rpx
}
.segmented {
  display: grid;
  grid-template-columns: 1fr 1fr;
  padding: 8rpx;
  gap: 8rpx;
  background: #edf2e8;
  border-radius: 24rpx;
  margin: 24rpx 0 28rpx
}
.segmented button {
  font-size: __SECONDARY_RPX__;
  color: __MUTED__;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center
}
.segmented .selected {
  background: white;
  color: __BRAND__;
  font-weight: 600
}
.horizontal {
  width: 100%
}
.horizontal-inner {
  display: flex;
  gap: 24rpx;
  padding-bottom: 12rpx
}
.horizontal-item {
  flex: 0 0 84%;
  min-width: 0
}
.panel {
  padding: 32rpx;
  background: white;
  border: 1rpx solid __BORDER__;
  border-radius: 28rpx;
  margin: 28rpx 0
}
.menu {
  padding: 8rpx 28rpx
}
.menu>button {
  width: 100%;
  display: block;
  text-align: left;
  padding: 24rpx 0;
  border-bottom: 1rpx solid __BORDER__;
  font-size: __BODY_RPX__
}
.menu>button:last-child {
  border-bottom: 0
}
.menu>button text {
  font-size: __SECONDARY_RPX__;
  color: __MUTED__;
  display: block;
  margin-top: 6rpx
}
.filters {
  white-space: nowrap;
  margin: 24rpx 0
}
.filters button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: #edf3e8;
  color: __MUTED__;
  font-size: __SECONDARY_RPX__;
  margin-right: 12rpx
}
.filters button.selected {
  background: __BRAND__;
  color: white
}
.picker-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0 28rpx;
  font-size: __SECONDARY_RPX__
}
.picker-row text {
  background: white;
  border: 1rpx solid __BORDER__;
  border-radius: 18rpx;
  padding: 16rpx;
  max-width: 70%
}
.note,.error-box {
  padding: 24rpx 28rpx;
  background: #eef3e8;
  color: #566b58;
  border-radius: 24rpx;
  font-size: __SECONDARY_RPX__;
  margin: 24rpx 0;
  line-height: 1.75
}
.error-box {
  background: #fff1e2;
  margin: 24rpx 32rpx;
  color: #81562c
}
.error-box button {
  color: __BRAND__;
  font-size: 30rpx
}
.loading {
  padding: 80rpx 32rpx;
  text-align: center;
  font-size: 30rpx;
  color: __MUTED__
}
.button {
  min-height: 96rpx;
  padding: 24rpx 26rpx;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center
}
.button.primary {
  background: __BRAND__;
  color: #fffdf1
}
.button.secondary {
  background: #eef3e8;
  color: __BRAND__;
  border: 1rpx solid __BORDER__
}
.button.full {
  width: 100%;
  margin-top: 24rpx
}
.station-list {
  margin: 32rpx 0
}
.station-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: white;
  border: 1rpx solid __BORDER__;
  border-radius: 28rpx;
  padding: 30rpx;
  margin-bottom: 22rpx
}
.station-name {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.5
}
.grow {
  flex: 1;
  min-width: 0
}
.stop-index {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #edf3e8;
  color: __BRAND__;
  font-size: __SECONDARY_RPX__;
  flex: none
}
.facts {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin: 28rpx 0
}
.facts>view,.facts>button {
  background: #edf3e8;
  border-radius: 24rpx;
  text-align: center;
  padding: 28rpx 20rpx;
  color: __BRAND__
}
.facts text {
  font-size: __CAPTION_RPX__;
  color: __MUTED__;
  display: block;
  margin-top: 8rpx
}
.step {
  background: white;
  border: 1rpx solid __BORDER__;
  border-radius: 32rpx;
  overflow: hidden;
  margin-bottom: 32rpx
}
.step-no {
  font-size: __SECONDARY_RPX__;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: __ACCENT__
}
.local-tip {
  background: #faf0dd;
  padding: 24rpx;
  border-radius: 22rpx;
  margin-top: 26rpx
}
.local-tip>view:first-child {
  font-size: __SECONDARY_RPX__;
  color: #936d35;
  font-weight: 600
}
.local-tip .copy {
  font-size: __SECONDARY_RPX__;
  color: #716c5b
}
.action-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-top: 28rpx
}
.info-list {
  display: grid;
  grid-template-columns: 150rpx minmax(0,1fr);
  gap: 28rpx 20rpx;
  margin-top: 28rpx;
  font-size: 30rpx
}
.info-list text {
  font-size: __SECONDARY_RPX__;
  color: __MUTED__
}
.native-map,.map-empty {
  width: 100%;
  height: 600rpx;
  border-radius: 32rpx;
  overflow: hidden;
  background: #e8ede4
}
.map-empty {
  padding: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  text-align: center;
  gap: 18rpx
}
.map-row {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid __BORDER__
}
.map-row image {
  width: 48rpx;
  height: 48rpx;
  flex: none
}
.map-row .copy {
  margin-top: 8rpx
}
.profile {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin: 18rpx 0 32rpx
}
.profile>image {
  width: 110rpx;
  height: 110rpx;
  padding: 20rpx;
  background: #e4ecd9;
  border-radius: 50%
}
