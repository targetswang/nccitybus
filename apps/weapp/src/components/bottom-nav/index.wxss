.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 50;
  display: grid;
  grid-template-columns: repeat(4,1fr);
  padding: 10rpx 16rpx calc(14rpx + env(safe-area-inset-bottom));
  background: #fffefb;
  border-top: 1rpx solid __BORDER__
}
.nav-item {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 6rpx;
  height: 96rpx;
  font-size: __CAPTION_RPX__;
  border-radius: 20rpx;
  color: __MUTED__
}
.nav-item image {
  width: 46rpx;
  height: 46rpx
}
.nav-item.selected {
  background: #edf3e8;
  color: __BRAND__;
  font-weight: 600
}
button {
  border: 0;
  background: none;
  line-height: 1.4;
  padding: 0
}
button::after {
  border: 0
}
