.narration {
  background: white;
  border: 1rpx solid __BORDER__;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-top: 24rpx
}
.narration button {
  background: #eef3e8;
  color: __BRAND__;
  font-size: 30rpx;
  border: 0;
  min-height: 88rpx;
  line-height: 1.5;
  display: flex;
  align-items: center;
  justify-content: center
}
.narration button::after {
  border: 0
}
.copy {
  font-size: __BODY_RPX__;
  line-height: 1.85;
  margin-top: 24rpx;
  color: __TEXT__
}
.error {
  font-size: __SECONDARY_RPX__;
  color: #89622d;
  margin-top: 16rpx
}
