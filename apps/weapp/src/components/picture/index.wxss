.picture {
  position: relative;
  width: 100%;
  height: 360rpx;
  background: #e4edde;
  overflow: hidden
}
.picture>image {
  width: 100%;
  height: 100%
}
.fallback {
  height: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 32rpx;
  text-align: center;
  background: linear-gradient(140deg,#dbe8d4,#eff0d9 60%,#e8d7b7);
  color: #456852
}
.fallback image {
  width: 72rpx;
  height: 72rpx
}
.fallback text {
  font-size: 30rpx;
  font-weight: 600
}
.label {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  font-size: __CAPTION_RPX__;
  border-radius: 999rpx;
  background: #fffaee;
  padding: 8rpx 16rpx;
  color: #88612c
}
