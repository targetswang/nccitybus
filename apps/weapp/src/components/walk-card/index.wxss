.card {
  background: white;
  border: 1rpx solid __BORDER__;
  border-radius: 32rpx;
  overflow: hidden;
  margin-bottom: 24rpx
}
.body {
  padding: 28rpx
}
.name {
  font-size: 34rpx;
  font-weight: 700;
  color: __TEXT__;
  line-height: 1.5;
  margin-top: 10rpx
}
.meta,.summary {
  font-size: __SECONDARY_RPX__;
  line-height: 1.7;
  color: __MUTED__
}
.summary {
  margin-top: 12rpx
}
.tags {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-top: 18rpx
}
.tags text {
  font-size: __CAPTION_RPX__;
  background: #f8edd7;
  color: #926c39;
  padding: 8rpx 14rpx;
  border-radius: 12rpx
}
