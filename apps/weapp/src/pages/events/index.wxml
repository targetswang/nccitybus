<view class="screen">
<view wx:if="{{error}}" class="error-box">
<text>{{error}}</text>
<button bindtap="retry">重新加载</button>
</view>
<view wx:if="{{loading}}" class="loading">正在读取…</view>
<view class="content">
<view class="h1">城市活动</view>
<view class="copy secondary">活动专题 · 我的报名</view>
<view wx:if="{{note}}" class="note">{{note}}</view>
<view wx:if="{{!session}}" class="panel">
<view class="copy">浏览无需登录，报名需要账户。</view>
<button class="button primary full" bindtap="login">手机号登录</button>
</view>
<view wx:for="{{events}}" wx:key="id" class="panel">
<image wx:if="{{item.cover}}" class="cover" src="{{item.cover}}" mode="aspectFill"/>
<view class="h2">{{item.title}}</view>
<view class="copy">{{item.description}}</view>
<view class="copy secondary">{{item.organizer}} · {{item.address}}</view>
<view class="tag">{{item.availability}}</view>
<view wx:if="{{item.operationalStatus==='cancelled'}}" class="note">活动已取消：{{item.cancellationReason}}</view>
<button class="button secondary full" data-page="event" data-id="{{item.id}}" bindtap="open">查看活动详情</button>
<button wx:if="{{item.registration==='free'}}" class="button primary full" data-id="{{item.id}}" bindtap="register" disabled="{{!session || item.availability!=='active'}}">免费活动报名</button>
</view>
<view wx:if="{{profile&&profile.registrations.length}}" class="panel">
<view class="h2">我的报名</view>
<view wx:for="{{profile.registrations}}" wx:key="id" class="record">{{item.title}} · {{item.status}}</view>
</view>
<view wx:if="{{!events.length&&!loading}}" class="note">暂无已发布城市活动。</view>
</view>
<bottom-nav active="{{active || 'me'}}"/>
</view>
