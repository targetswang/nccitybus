<view class="screen">
<view wx:if="{{error}}" class="error-box">
<text>{{error}}</text>
<button bindtap="retry">重新加载</button>
</view>
<view wx:if="{{loading}}" class="loading">正在读取…</view>
<view class="content" wx:if="{{catalog}}">
<view class="h1">我的收藏</view>
<poi-card wx:for="{{pois}}" wx:key="id" poi="{{item}}"/>
<view wx:if="{{!pois.length}}" class="note">还没有可显示的收藏，去漫游看看。</view>
<view wx:if="{{missingCount}}" class="note">{{missingCount}}项收藏内容已不可用，原收藏标识仍被保留。</view>
</view>
<bottom-nav active="{{active || 'home'}}"/>
</view>
