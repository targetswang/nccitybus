<view class="screen">
<view wx:if="{{error}}" class="error-box">
<text>{{error}}</text>
<button bindtap="retry">重新加载</button>
</view>
<view wx:if="{{loading}}" class="loading">正在读取…</view>
<view class="content" wx:if="{{catalog}}">
<view class="h1">乘车指南</view>
<view class="panel" wx:for="{{catalog.guides}}" wx:key="title">
<text class="step-no">{{index+1}}</text>
<view class="h2">{{item.title}}</view>
<view class="copy">{{item.body}}</view>
</view>
<button class="button primary full" bindtap="transit">打开微信乘车码</button>
</view>
<bottom-nav active="{{active || 'home'}}"/>
</view>
