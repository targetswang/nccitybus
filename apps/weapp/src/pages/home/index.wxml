<view class="screen">
<view wx:if="{{error}}" class="error-box">
<text>{{error}}</text>
<button bindtap="retry">重新加载</button>
</view>
<view wx:if="{{loading}}" class="loading">正在读取…</view>
<block wx:if="{{catalog}}">
<view class="hero">
<text class="tag gold">城市漫游环线</text>
<view class="hero-title">把南充，
坐成一段风景。</view>
<view class="hero-sub">沿着嘉陵江，慢慢看这座城。</view>
<image class="hero-bus" src="/assets/hero-bus.png"/>
</view>
<view class="quick-actions">
<button class="quick" bindtap="transit">
<image src="/assets/map.png"/>
<view>
<text class="strong">乘车码</text>
<text class="small">刷码上车</text>
</view>
</button>
<button class="quick" bindtap="live">
<image src="/assets/bus.png"/>
<view>
<text class="strong">实时查车</text>
<text class="small">车辆与站点</text>
</view>
</button>
</view>
<view class="notice" data-page="guide" bindtap="open">{{catalog.notice}}</view>
<view class="content">
<view class="section-title">
<text>一条线，慢游南充</text>
<button data-page="route" bindtap="open">线路总览</button>
</view>
<view class="route-card" data-page="route" bindtap="open">
<view class="route-cover">
<text class="route-number">01</text>
<view>
<text>CITY LOOP</text>
<view>嘉陵江畔 · 城市漫游</view>
</view>
<image src="/assets/bus.png"/>
</view>
<view class="card-body">
<view class="h3">{{catalog.routeName}}</view>
<view class="copy secondary">{{routeLine}}</view>
<text class="tag">随到随上 · 随站下车</text>
</view>
</view>
<view class="section-title">
<text>漫游精选</text>
<button bindtap="explore">查看更多</button>
</view>
<view class="segmented">
<button class="{{mode==='walks'?'selected':''}}" data-mode="walks" bindtap="modeChange">路线玩法</button>
<button class="{{mode==='places'?'selected':''}}" data-mode="places" bindtap="modeChange">沿线地点</button>
</view>
<scroll-view scroll-x class="horizontal">
<view wx:if="{{mode==='walks'}}" class="horizontal-inner">
<view wx:for="{{walks}}" wx:key="id" class="horizontal-item">
<walk-card walk="{{item}}" cover="{{item.cover}}"/>
</view>
</view>
<view wx:else class="horizontal-inner">
<view wx:for="{{pois}}" wx:key="id" class="horizontal-item">
<poi-card poi="{{item}}"/>
</view>
</view>
</scroll-view>
<view class="section-title">出发前，先看这里</view>
<view class="panel menu">
<button data-page="stations" bindtap="open">全部环线站点 <text>候车信息与周边内容</text>
</button>
<button data-page="guide" bindtap="open">乘车指南 <text>乘车码与环线规则</text>
</button>
<button data-page="privacy" bindtap="open">数据与隐私 <text>定位、收藏与账号说明</text>
</button>
</view>
</view>
</block>
</view>
