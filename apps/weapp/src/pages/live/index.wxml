<view class="screen">
<view wx:if="{{error}}" class="error-box">
<text>{{error}}</text>
<button bindtap="retry">重新加载</button>
</view>
<view wx:if="{{loading}}" class="loading">正在读取…</view>
<view class="content">
<view class="section-title">
<text>漫游地图</text>
<button bindtap="refresh">刷新</button>
</view>
<view class="note">{{statusText}}</view>
<picker wx:if="{{routes.length>1}}" range="{{routes}}" range-key="name" value="{{routeIndex}}" bindchange="routeChange">
<view class="picker-row">选择线路：{{routes[routeIndex].name}}</view>
</picker>
<scroll-view scroll-x class="filters">
<button wx:for="{{layers}}" wx:key="key" class="{{layer===item.key?'selected':''}}" data-layer="{{item.key}}" bindtap="layerChange">{{item.label}}</button>
</scroll-view>
<map wx:if="{{hasGeometry}}" class="native-map" latitude="{{center.latitude}}" longitude="{{center.longitude}}" scale="14" markers="{{markers}}" polyline="{{polylines}}" show-location="{{showLocation}}" bindmarkertap="markerTap"/>
<view wx:else class="map-empty">
<view class="h3">尚无可显示的真实地图点</view>
<view class="copy secondary">不会用示意轨迹或景区中心点冒充公交线路和站牌。</view>
</view>
<button class="button secondary full" bindtap="locate">我的位置</button>
<view class="section-title">{{layer==='vehicles'?'车辆位置':layer==='stations'?'公交站点':'沿线地点'}}</view>
<view class="panel menu">
<view wx:for="{{items}}" wx:key="id" class="map-row" data-index="{{index}}" bindtap="itemTap">
<image src="/assets/{{item.kind==='vehicle'?'bus':'pin'}}.png"/>
<view class="grow">
<view class="h3">{{item.name}}</view>
<view class="copy secondary">{{item.subtitle}}</view>
</view>
<text wx:if="{{item.kind==='poi'}}">›</text>
</view>
<view wx:if="{{!items.length}}" class="note">{{layer==='vehicles'?'暂无有效车辆定位':'当前图层暂无可用数据'}}</view>
</view>
<button class="button secondary full" bindtap="stations">查看文旅站点与玩法</button>
</view>
</view>
