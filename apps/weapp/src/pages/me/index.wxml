<view class="screen">
<view wx:if="{{error}}" class="error-box">
<text>{{error}}</text>
<button bindtap="retry">重新加载</button>
</view>
<view wx:if="{{loading}}" class="loading">正在读取…</view>
<view class="content">
<view class="profile">
<image src="/assets/user.png"/>
<view>
<view class="h1">我的漫游</view>
<view class="copy secondary">{{session?'已登录，可同步收藏':'收藏保存在当前设备'}}</view>
</view>
</view>
<view class="facts">
<button data-page="favorites" bindtap="open">
<view class="h2">{{favoriteCount}}</view>
<view>我的收藏</view>
</button>
<button data-page="stations" bindtap="open">
<view class="h2">站点</view>
<view>候车与游览</view>
</button>
</view>
<button wx:if="{{loginAvailable && !session}}" class="button primary full" bindtap="login">微信登录并同步收藏</button>
<button wx:if="{{session}}" class="button secondary full" bindtap="logout">退出登录（保留本机收藏）</button>
<view class="panel menu">
<button data-page="favorites" bindtap="open">我的收藏</button>
<button data-page="member" bindtap="open">会员服务</button>
<button data-page="rights" bindtap="open">我的权益</button>
<button data-page="events" bindtap="open">城市活动</button>
<button data-page="messages" bindtap="open">我的消息</button>
<button data-page="support" bindtap="open">客服与反馈</button>
<button data-page="guide" bindtap="open">乘车指南</button>
<button data-page="privacy" bindtap="open">数据与隐私</button>
</view>
</view>
</view>
