<view class="screen">
<view wx:if="{{error}}" class="error-box">
<text>{{error}}</text>
<button bindtap="retry">重新加载</button>
</view>
<view wx:if="{{loading}}" class="loading">正在读取…</view>
<view class="content" wx:if="{{poi}}">
<nc-picture src="{{poi.cover}}" alt="{{poi.name}}" label="{{poi.category}}"/>
<view class="page-intro">
<view class="h1">{{poi.name}}</view>
<view class="copy secondary">{{poi.subcategory}} · {{nodeName}}</view>
</view>
<view class="panel">
<view class="h2">为什么值得去</view>
<view class="copy">{{poi.description}}</view>
<view class="info-list">
<text>地址</text>
<view>{{poi.address}}</view>
<text>营业信息</text>
<view>{{poi.openingHours || '请向商家或场地确认'}}</view>
<text>消费建议</text>
<view>{{poi.priceAdvice || '以现场公示为准'}}</view>
</view>
</view>
<button wx:if="{{canNavigate}}" class="button primary full" bindtap="navigatePoi">地图导航</button>
<view wx:else class="note">暂未确认精确位置，请按地址核实后出行。</view>
<nc-narration text="{{poi.narration}}" audio-url="{{poi.audioUrl}}"/>
<view class="action-row">
<button class="button secondary" bindtap="favorite">{{liked?'已收藏 · 取消':'收藏地点'}}</button>
<button class="button primary" data-page="station" data-id="{{poi.nodeId}}" bindtap="open">查看关联站点</button>
</view>
<view wx:if="{{syncError}}" class="note">{{syncError}}</view>
</view>
<view wx:elif="{{!loading && !error}}" class="note">地点不存在或已下线</view>
<bottom-nav active="{{active || 'home'}}"/>
</view>
