<view class="screen">
<view wx:if="{{error}}" class="error-box">
<text>{{error}}</text>
<button bindtap="retry">重新加载</button>
</view>
<view wx:if="{{loading}}" class="loading">正在读取…</view>
<view class="content" wx:if="{{catalog}}">
<view class="h1">数据与隐私</view>
<view class="panel">
<view class="h2">浏览与收藏</view>
<view class="copy">{{catalog.privacy}}</view>
</view>
<view class="panel">
<view class="h2">内容与图片</view>
<view class="copy">路线文字是游览建议，并非实时营业、发车或门票信息。未核实的营业时间和消费金额不作为事实展示。</view>
</view>
</view>
<bottom-nav active="{{active || 'home'}}"/>
</view>
