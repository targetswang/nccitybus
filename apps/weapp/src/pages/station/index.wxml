<view class="screen">
<view wx:if="{{error}}" class="error-box">
<text>{{error}}</text>
<button bindtap="retry">重新加载</button>
</view>
<view wx:if="{{loading}}" class="loading">正在读取…</view>
<view class="content" wx:if="{{node}}">
<view class="h1">{{node.name}}</view>
<view class="copy secondary">{{node.persona}}</view>
<view class="panel">
<view class="h2">乘车与候车</view>
<view class="copy">{{official.length?'已关联公交系统站点。':'公交站牌位置尚未完成确认，请勿以景区中心点作为候车点。'}}</view>
<block wx:for="{{official}}" wx:key="code">
<button wx:if="{{item.canNavigate}}" class="button secondary full" data-index="{{index}}" bindtap="navigateStation">导航至{{item.name}}</button>
</block>
<button class="button secondary full" bindtap="live">查看实时车辆</button>
</view>
<view class="section-title">这一站怎么玩</view>
<poi-card wx:for="{{pois}}" wx:key="id" poi="{{item}}"/>
</view>
<view wx:elif="{{!loading && !error}}" class="note">站点不存在或已下线</view>
<bottom-nav active="{{active || 'home'}}"/>
</view>
