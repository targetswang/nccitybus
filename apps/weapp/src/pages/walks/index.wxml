<view class="screen">
<view wx:if="{{error}}" class="error-box">
<text>{{error}}</text>
<button bindtap="retry">重新加载</button>
</view>
<view wx:if="{{loading}}" class="loading">正在读取…</view>
<view class="content" wx:if="{{catalog}}">
<view class="h1">选一条路线，慢慢认识南充</view>
<walk-card wx:for="{{walks}}" wx:key="id" walk="{{item}}" cover="{{item.cover}}"/>
</view>
<bottom-nav active="{{active || 'home'}}"/>
</view>
